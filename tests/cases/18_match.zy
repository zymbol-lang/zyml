// ?? pattern matching — all six pattern kinds
score = 85
grade = ?? score {
    90..100 => 'A'
    80..89  => 'B'
    70..79  => 'C'
    60..69  => 'D'
    _       => 'F'
}
>> "grade: " grade ¶
color = "red"
code = ?? color {
    "red"   => "#FF0000"
    "green" => "#00FF00"
    _       => "#000000"
}
>> code ¶
temperature = -5
state = ?? temperature {
    < 0   => "ice"
    < 20  => "cold"
    _     => "hot"
}
>> state ¶
n = 42
?? n {
    == 0    => { >> "zero" ¶ }
    < 0     => { >> "negative" ¶ }
    _       => { >> "positive: " n ¶ }
}
expected = 200
c2 = 200
r1 = ?? c2 {
    expected => "ok"
    _        => "fail"
}
>> r1 ¶
weekdays = ["Mon", "Tue", "Wed", "Thu", "Fri"]
day = "Mon"
r2 = ?? day {
    weekdays => "weekday"
    _        => "weekend"
}
>> r2 ¶
m = 3
label = ?? m {
    [1, 2] => "low"
    [3, 4] => "mid"
    _      => "other"
}
>> label ¶
cmd = ["run", "main.zy"]
?? cmd {
    ["run", _]    => { >> "run command" ¶ }
    ["build", _]  => { >> "build command" ¶ }
    _             => { >> "unknown" ¶ }
}
data = [10, 20, 30]
?? data {
    [_]       => { >> "one element" ¶ }
    [_, _]    => { >> "two elements" ¶ }
    [_, _, _] => { >> "three elements" ¶ }
    _         => { >> "more" ¶ }
}
key = 'P'
?? key {
    'p' || 'P' => { >> "pause" ¶ }
    'q' || 'Q' => { >> "quit" ¶ }
    _          => { >> "other" ¶ }
}
z = 25
zone = ?? z {
    1..10 || 20..30 => "in range"
    0               => "zero"
    _               => "outside"
}
>> zone ¶
v = 150
st = ?? v {
    < 0 || > 100 => "extreme"
    _            => "normal"
}
>> st ¶
d = 6
kind = ?? d {
    1 || 3 || 5 || 7 => "odd"
    2 || 4 || 6 || 8 => "even"
    _                => "out of range"
}
>> kind ¶
