// Casts, precision and number formatting
i = 42
f = 3.7
>> ##.i ¶
>> ###f ¶
>> ##!f ¶
nf = -2.9
>> ###nf ¶
>> ##!nf ¶
>> ###(7 / 2.0) ¶
>> ##!(7 / 2.0) ¶
>> ##!'A' ¶
>> ##!'あ' ¶
pi = 3.14159265
>> #.2|pi| ¶
>> #.4|pi| ¶
>> #!2|pi| ¶
>> #.2|"19.876"| ¶
>> #.0|19.9| ¶
>> #!0|19.9| ¶
v1 = #|"42"|
>> v1 ¶
v2 = #|"3.14"|
>> v2 ¶
v3 = #|"abc"|
>> v3 ¶
v4 = #|99|
>> v4 ¶
nfmt = 1234567
>> #,|nfmt| ¶
big = 3141592.653
>> #,.2|big| ¶
>> #,!2|big| ¶
xsci = 12345.678
>> #^|xsci| ¶
>> #^.3|xsci| ¶
>> #^!3|xsci| ¶
