// Strings, interpolation, escapes
name = "Alice"
n = 42
>> "Hello, {name}!" ¶
>> "You have {n} items" ¶
>> "tab:\there" ¶
>> "quote:\"q\"" ¶
>> "brace:\{literal\}" ¶
>> "a" "b" "c" ¶
s = "héllo"
>> (s$#) ¶
>> s[1] ¶
>> s[3] ¶
>> s[-1] ¶
>> (s$[1..3]) ¶
>> ("abc" $+ "def") ¶
>> ("hello" $? "ell") ¶
>> ("hello" $? "xyz") ¶
