// Advanced string operators
s = "hello world"
>> (s$+ "!") ¶
>> (s$+[6] "!!!") ¶
>> (s$- 'l') ¶
>> (s$-- 'l') ¶
>> (s$-[1]) ¶
>> (s$-[1..5]) ¶
>> (s$-[1:5]) ¶
>> (s$?? "o") ¶
>> (s$~~["l":"L"]) ¶
>> (s$~~["l":"L":1]) ¶
>> ("a,b,c,d" $/ ',') ¶
>> ("one::two::three" $/ "::") ¶
>> ("=" $* 20) ¶
>> ("x" $* 0) ¶
n = 42
pi = 3.14
flag = #1
b = "n=" $++ n " pi=" pi " ok=" flag
>> b ¶
ab = [1, 2, 3] $++ 4 5 6
>> ab ¶
