// Lambdas, closures, first class functions
double = x -> x * 2
add = (a, b) -> a + b
square = x -> x * x
>> double(5) ¶
>> add(3, 7) ¶
>> square(9) ¶
describe = x -> {
    ? x > 0 { <~ "positive" }
    _? x < 0 { <~ "negative" }
    <~ "zero"
}
>> describe(5) ¶
>> describe(-3) ¶
>> describe(0) ¶
multiplier = 3
triple = x -> x * multiplier
>> triple(7) ¶
make_adder(k) { <~ x -> x + k }
add10 = make_adder(10)
add20 = make_adder(20)
>> "add10(5)=" add10(5) ¶
>> "add20(5)=" add20(5) ¶
apply(f, x) { <~ f(x) }
>> apply(x -> x * 3, 7) ¶
ops = [x -> x+1, x -> x*2, x -> x*x]
>> ops[1](5) ¶
>> ops[2](5) ¶
>> ops[3](5) ¶
