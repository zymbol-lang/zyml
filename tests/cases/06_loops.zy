// Every loop form
i = 0
@ {
    i++
    ? i >= 5 { @! }
    >> i " "
}
>> ¶
@ 5 { >> "Zz" }
>> ¶
n = 1
@ n <= 100 { n *= 2 }
>> n ¶
fruits = ["apple", "pear", "grape"]
@ fruit:fruits { >> "  - " fruit ¶ }
@ i:0..4 { >> i " " }
>> ¶
@ i:1..9:2 { >> i " " }
>> ¶
@ i:10..1:3 { >> i " " }
>> ¶
@ c:"hello" { >> c "-" }
>> ¶
@ i:1..10 {
    ? i % 2 == 0 { @> }
    ? i > 7 { @! }
    >> i " "
}
>> ¶
