// The $ family on arrays
arr = [1, 2, 3, 4, 5]
>> (arr$+ 6) ¶
>> (arr$+[2] 99) ¶
>> (arr$- 3) ¶
>> ([1, 2, 3, 2, 4]$-- 2) ¶
>> (arr$-[1]) ¶
>> (arr$-[2..3]) ¶
>> (arr$-[2:2]) ¶
>> (arr$? 3) ¶
>> ([1, 2, 1, 3, 1]$?? 1) ¶
>> (arr$[1..3]) ¶
>> (arr$[1:3]) ¶
u = [3, 1, 4, 1, 5, 9, 2, 6]
>> (u$^+) ¶
>> (u$^-) ¶
w = ["banana", "apple", "cherry", "date"]
>> (w$^+) ¶
>> (w$^-) ¶
>> arr ¶
