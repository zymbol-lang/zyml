// Arrays: access, mutation, value semantics
arr = [10, 20, 30, 40, 50]
>> arr ¶
>> arr[1] ¶
>> arr[3] ¶
>> arr[-1] ¶
>> arr[-2] ¶
>> (arr$#) ¶
b = arr
arr[1] = 99
>> b ¶
>> arr ¶
>> (arr$[1..3]) ¶
>> (arr$[2:3]) ¶
>> (arr$+ 60) ¶
>> (arr$? 30) ¶
>> (arr$? 77) ¶
m = [[1,2],[3,4]]
>> m[1][2] ¶
>> m ¶
@ i:1..arr$# { >> arr[i] " " }
>> ¶
mixed = ["a", "b"]
>> mixed ¶
