// Value semantics: `b = a` must survive a later write through either name.
//
// The engine shares the cell array on assignment and copies only when someone
// writes, so these are the cases that would break if the sharing leaked: a
// nested row pulled out of a grid, a write through the copy rather than the
// original, a chain of three names, and a function argument.
a = [1, 2, 3]
b = a
a[1] = 99
>> "1. plano   a=" a " b=" b ¶

// Nested aliasing: pulling a row out must copy it, not alias into the grid.
m = [[1, 2], [3, 4]]
n = m
fila = m[1]
fila[2] = 77
>> "2. fila    m=" m " n=" n " fila=" fila ¶

// Replacing a whole row must leave the source grid alone
d1 = [[1, 2], [3, 4]]
d2 = d1[1]$~ [9, 9]
>> "3. fila$~  d1=" d1 " d2=" d2 ¶

// Write through the copy instead of the original
r = [1, 2, 3]
s = r
s[2] = 88
>> "4. inverso r=" r " s=" s ¶

// Chain of three names
t = [1, 2]
u = t
v = u
t[1] = 7
>> "5. cadena  t=" t " u=" u " v=" v ¶

// Functions take arguments by value
f(x) { x[1] = 42  <~ x }
w = [1, 2]
z = f(w)
>> "6. función w=" w " z=" z ¶

g1 = [1, 2, 3]
g2 = g1[2]$~ 9
>> "7. dolar~  g1=" g1 " g2=" g2 ¶

nt1 = (x: 1, y: 2)
nt2 = nt1
nt3 = nt1["x"]$~ 9
>> "8. ntupla  nt1=" nt1 " nt2=" nt2 " nt3=" nt3 ¶

h1 = [1, 2]
h2 = h1$+ 3
>> "9. append  h1=" h1 " h2=" h2 ¶

// Grid built in a loop, one row replaced functionally
grid = []
@ _i:1..3 { grid = grid$+ [0, 0] }
keep = grid
fila2 = grid[2]
fila2[1] = 5
grid = grid[2]$~ fila2
>> "10. grid  grid=" grid " keep=" keep ¶
